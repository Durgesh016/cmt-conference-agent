# Copy this file to .env and fill in your keys.
# .env is git-ignored; never commit or share it.

# Ollama LLM settings (the agent uses a local LLaMA model via Ollama)
# OLLAMA_MODEL=llama3.2             # default model (any Ollama model that supports tool use)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Microsoft CMT account (optional: leave empty and the agent opens a browser for you to sign in)
CMT_EMAIL=
CMT_PASSWORD=

# EasyChair account (optional: leave empty and the agent opens a browser for you to sign in)
EASYCHAIR_EMAIL=
EASYCHAIR_PASSWORD=

# Optional settings
# EASYCHAIR_STATE_PATH=.auth/easychair_state.json
# CMT_HEADLESS=false          # true = no browser window (needs a saved session or the credentials above)
# CMT_KEEP_OPEN=true          # false = close the browser automatically when the task is done
# CMT_MIN_DELAY=2             # seconds between actions that make CMT do work (be gentle)
# CMT_MAX_DELAY=5
# CMT_OUTPUT_DIR=output
# CMT_LOG_DIR=logs
# CMT_STATE_PATH=.auth/cmt_state.json
# CMT_BASE_URL=https://cmt3.research.microsoft.com
